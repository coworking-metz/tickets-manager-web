{
  "name": "tickets-manager-web",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "vite build",
    "check": "eslint src && vue-tsc",
    "check-deps": "npm ls > /dev/null 2>&1 || npm run clean",
    "clean": "rm -rf node_modules/ && npm install",
    "dev": "vite",
    "postinstall": "patch-package",
    "predev": "npm run check-deps",
    "preview": "vite preview",
    "serve": "docker run --rm --name tickets-manager-web-nginx -v $(pwd)/dist:/usr/share/nginx/html:ro -p9999:80 nginx",
    "update": "ncu --deep --cooldown 7d",
    "update:interactive": "npm run update -- --interactive"
  },
  "dependencies": {
    "@dotlottie/player-component": "^2.7.12",
    "@headlessui/vue": "^1.7.23",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@jamescoyle/vue-icon": "^0.1.2",
    "@mdi/js": "^7.4.47",
    "@sentry/vue": "^10.74.0",
    "@tanstack/vue-query": "^5.107.1",
    "@thermal-label/letratag-web": "^0.6.1",
    "@thermal-label/transport": "^0.6.1",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-subscript": "^3.33.1",
    "@tiptap/extension-superscript": "^3.33.1",
    "@tiptap/extension-task-item": "^3.33.1",
    "@tiptap/extension-task-list": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extension-underline": "^3.33.1",
    "@tiptap/markdown": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/vue-3": "^3.33.1",
    "@unhead/vue": "^3.4.3",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vuepic/vue-datepicker": "^14.0.0",
    "@vueuse/core": "^14.4.0",
    "autonumeric": "^4.10.10",
    "axios": "^1.21.1",
    "axios-retry": "^4.5.0",
    "dayjs": "^1.11.23",
    "echarts": "^5.5.0",
    "floating-vue": "^5.4.0",
    "lodash": "^4.18.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "typeface-inter": "^3.18.1",
    "uuid": "^14.0.3",
    "vue": "^3.5.45",
    "vue-echarts": "6.7.3",
    "vue-i18n": "^11.4.18",
    "vue-number-animation": "^2.0.2",
    "vue-qs": "^0.2.7",
    "vue-router": "^5.5.0",
    "vue-sonner": "^2.0.9",
    "vue-virtual-scroller": "^3.0.5"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/uuid": "^11.0.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "npm-check-updates": "^23.1.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=24.0.0"
  },
  "overrides": {
    "vue-qs": {
      "vue-router": "$vue-router"
    }
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "vue-demi@0.13.11": true,
    "vue-demi@0.11.4": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "sharp@0.33.5": true,
    "unrs-resolver@1.12.2": true,
    "vue-echarts@6.7.3": true,
    "esbuild@0.28.2": true
  }
}
